# Page statistics for erisml.org. Imported by atlas-caddy's /home/claude/Caddyfile:
#   import /archive/experiments/erisml-stats/repo/tools/site-stats/stats.caddy
# Caddy obtains the certificate for this name as it does for the host's other sites.
# There is deliberately no `log` directive: Caddy then writes no access log for this site,
# so visitors' addresses are not kept on disk by the proxy.
stats.atlas-sjsu.duckdns.org {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8095
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
